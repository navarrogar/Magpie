{
  "manifest_version": 3,
  "name": "Magpie",
  "version": "1.0",
  "description": "Grab videos and GIFs from X/Twitter \u2014 button on every tweet, or paste a link in the popup.",
  "permissions": [
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.fxtwitter.com/*",
    "https://api.vxtwitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}